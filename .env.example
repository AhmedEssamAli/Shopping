# Copy to .env and fill in. .env is git-ignored.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram chat IDs allowed to use the bot (send /start once; the bot replies with your ID)
TELEGRAM_ALLOWED_CHAT_IDS=

# Optional: lets the bot parse free-text and Arabic lists ("2 لبن جهينة 1 لتر, rice 5kg").
# Without it a simple local parser is used.
ANTHROPIC_API_KEY=

# Web comparison table. Keep host 127.0.0.1 and expose it to your phone with Tailscale.
WEB_HOST=127.0.0.1
WEB_PORT=8765
# Base URL the bot puts in links. After `tailscale serve --bg 8765`, use the https://<pc>.<tailnet>.ts.net address it prints
WEB_BASE_URL=http://127.0.0.1:8765
# Random secret; links carry it so only you can open results. Generate: python -c "import secrets;print(secrets.token_urlsafe(16))"
WEB_TOKEN=

# Delivery location (New Cairo / 5th Settlement default) used as browser geolocation
AREA_NAME=New Cairo / 5th Settlement
AREA_LAT=30.0074
AREA_LON=31.4913

# Optimiser defaults
MAX_ORDERS=2
# How often `shopper serve` re-prices your /watch items
WATCH_INTERVAL_HOURS=6

# Where the signed-in browser profile, captures and price history live
SHOPPER_HOME=~/.shopper
# Set to 0 to watch the browser work
BROWSER_HEADLESS=1
